# VHS tape for agent-guardrail demo
# https://github.com/charmbracelet/vhs
#
# Run:  vhs demo.tape
# Output: demo.gif

Output Documents/agent-guardrail/demo.gif

Set FontSize 24
Set Width 1000
Set Height 500
Set TypingSpeed 60ms
Set Theme "Dracula"

Type "cd Documents/agent-guardrail"
Enter
Sleep 1s
Type "npm run demo"
Enter
Sleep 4s
